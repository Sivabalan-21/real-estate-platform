# --- Database (required) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=siva21
POSTGRES_DB=auth_db
# DATABASE_URL is constructed automatically by docker-compose.yml from the
# three values above — you don't need to set it yourself for local dev.

# --- Auth (required) ---
SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITE_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=30

# --- URLs (optional — sensible defaults exist in code) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Mail (optional — leave blank to disable email sending) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=